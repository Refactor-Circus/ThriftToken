{
    "name": "refactor-circus/thrift-token",
    "description": "TOON (Token-Oriented Object Notation) 4.4 encoder and decoder for Laravel",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Jay Fletcher",
            "email": "5743488+jayjfletcher@users.noreply.github.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "illuminate/support": "^13.35",
        "illuminate/container": "^13.35",
        "illuminate/database": "^13.35",
        "illuminate/http": "^13.35"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/ai": "^1.2",
        "laravel/pint": "^1.32.1",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.3.1",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "refactor-circus/ringside": "dev-main",
        "refactor-circus/standards": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "RefactorCircus\\ThriftToken\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RefactorCircus\\ThriftToken\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RefactorCircus\\ThriftToken\\ThriftTokenServiceProvider"
            ],
            "aliases": {
                "ThriftToken": "RefactorCircus\\ThriftToken\\Facades\\ThriftToken"
            }
        },
        "pest": {
            "plugins": [
                "RefactorCircus\\ThriftToken\\Domains\\Integration\\Pao\\Plugin"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "refactor-circus/ringside": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=2G",
        "pint": "vendor/bin/pint -v --preset laravel",
        "pint:test": "vendor/bin/pint --test --preset laravel",
        "post-install-cmd": [
            "@php bin/install-git-hooks.php"
        ],
        "local:install": [
            "@php bin/composer-local.php",
            "@putenv COMPOSER=composer.local.json",
            "@composer install"
        ],
        "local:update": [
            "@php bin/composer-local.php",
            "@putenv COMPOSER=composer.local.json",
            "@composer update"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Refactor-Circus/Ringside.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Refactor-Circus/Standards.git"
        }
    ]
}
