{
    "name": "refactor-circus/thrift-token",
    "description": "TOON (Token-Oriented Object Notation) v3.3 encoder and decoder for Laravel",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "illuminate/support": "^13.0",
        "illuminate/container": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "laravel/pint": "^1.29",
        "larastan/larastan": "^3.12",
        "laravel/ai": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "RefactorCircus\\ThriftToken\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RefactorCircus\\ThriftToken\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RefactorCircus\\ThriftToken\\ThriftTokenServiceProvider"
            ],
            "aliases": {
                "ThriftToken": "RefactorCircus\\ThriftToken\\Facades\\ThriftToken"
            }
        },
        "pest": {
            "plugins": [
                "RefactorCircus\\ThriftToken\\Domains\\Integration\\Pao\\Plugin"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=2G",
        "pint": "vendor/bin/pint -v --preset laravel",
        "pint:test": "vendor/bin/pint --test --preset laravel",
        "post-install-cmd": [
            "@php bin/install-git-hooks.php"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
